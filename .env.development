
PORT=8001
NODE_ENV=development

# =========================================
# DATABASE CONNECTIONS
# =========================================
ROOT_DB_URI=mongodb://127.0.0.1:27017/mk_root_db
AFFILIATE_DB_URI=mongodb://127.0.0.1:27017/mk_affiliate_db
AUDITLOG_DB_URI=mongodb://127.0.0.1:27017/mk_audit_logs

# ===============================
# JWT / Auth Configuration
# ===============================
JWT_SECRET=supersecretkey      
JWT_EXPIRES_IN=1d

# ===============================
# Super Admin Default Credentials
# (used by seedDefaultValue.js)
# ===============================
SUPER_ADMIN_EMAIL=root@mkproject.com
SUPER_ADMIN_PASSWORD=Root@12345
SUPER_ADMIN_NAME=ROOT ADMIN

# ===============================
# CORS Configuration
# ===============================
CORS_ORIGIN=*

# ===============================
# Redis Configuration
# ===============================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=    

# ===============================
# Rate Limiter Configuration
# ===============================
# Login route (IP-based)
LOGIN_RATE_WINDOW_MINUTES=100
LOGIN_RATE_MAX_REQUESTS=100
LOGIN_RATE_KEY_TYPE=ip

# Public auth routes (IP-based)
PUBLIC_RATE_WINDOW_MINUTES=100
PUBLIC_RATE_MAX_REQUESTS=100
PUBLIC_RATE_KEY_TYPE=ip

# Protected routes (user-based)
USER_RATE_WINDOW_MINUTES=100
USER_RATE_MAX_REQUESTS=1000
USER_RATE_KEY_TYPE=user

# ===============================
# Optional: Email / SMTP
# ===============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password