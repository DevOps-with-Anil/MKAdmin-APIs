{
  "info": {
    "name": "AdminAPIs Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for AdminAPIs Backend APIs"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:4000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"super@admin.com\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "Create Module",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/modules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "modules"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ANALYTICS\",\n  \"type\": \"ROOT\",\n  \"actions\": [{\"name\": \"VIEW\"}, {\"name\": \"EXPORT\"}]\n}"
        }
      }
    },
    {
      "name": "List Modules",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/modules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "modules"
          ]
        }
      }
    },
    {
      "name": "Update Module Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/modules/{{moduleId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "modules",
            "{{moduleId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}"
        }
      }
    },
    {
      "name": "Add Actions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/modules/{{moduleId}}/actions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "modules",
            "{{moduleId}}",
            "actions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actions\": [{\"name\": \"DELETE\"}]\n}"
        }
      }
    },
    {
      "name": "Update Action Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/modules/{{moduleId}}/actions/{{actionName}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "modules",
            "{{moduleId}}",
            "actions",
            "{{actionName}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}
